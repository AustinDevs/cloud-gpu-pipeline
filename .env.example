# DigitalOcean API
DO_API_TOKEN=your_digitalocean_api_token
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_BUCKET=splatwalk
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# SSH Key for GPU Droplets
DO_SSH_KEY_ID=your_ssh_key_id
DO_SSH_PRIVATE_KEY_PATH=~/.ssh/splatwalk_gpu

# GPU Droplet Config
# RTX 6000 Ada:    gpu-6000adax1-48gb ($1.57/hr) — recommended, usually available
# H100 80GB:       gpu-h100x1-80gb    ($3.40/hr) — max headroom
# RTX 4000 Ada:    gpu-4000adax1-20gb ($0.76/hr) — budget, set tuning vars below
GPU_DROPLET_SIZE=gpu-6000adax1-48gb
GPU_DROPLET_REGION=tor1
GPU_DROPLET_IMAGE=gpu-h100x1-80gb-gen1

# Volume ID for runtime (everything-on-volume architecture)
# Create + populate with: scripts/setup-volume.sh
DO_VOLUME_ID=your_volume_id

# Pipeline tuning (defaults shown; also overridable per-job via run_job.sh flags)
# For smaller GPUs like RTX 4000 Ada 20GB use MAX_N_VIEWS=16
# MAX_N_VIEWS=24
# TRAIN_ITERATIONS=10000
# IMAGE_SIZE=512

# GitHub token (only needed if the repo is private — used to fetch pipeline
# scripts onto the droplet at runtime)
GHCR_TOKEN=

# Slack Notifications (optional)
# Create an Incoming Webhook at https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
